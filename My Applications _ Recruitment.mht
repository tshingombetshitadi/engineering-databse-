.mdf-status--info { color: var(--accent-0-lightest); background-color: var(--accent-0-dark); border: 1px solid var(--accent-0-dark); }

.mdf-status--warning { color: var(--accent-5-lightest); background-color: var(--accent-5-dark); border: 1px solid var(--accent-5-dark); }

.mdf-status--error { color: var(--accent-6-lightest); background-color: var(--accent-6); border: 1px solid var(--accent-6); }

.mdf-status--success { color: var(--accent-1-lightest); background-color: var(--accent-1-dark); border: 1px solid var(--accent-1-dark); }

.mdf-status--delegate { color: var(--accent-0-dark); background-color: var(--white); border: 1px solid var(--accent-0-dark); }

.mdf-status--default { color: var(--white); background-color: var(--white); border: 1px solid var(--accent-0-dark); }

.mdf .step-navigation .step-navigation__step { flex: 0 0 45px; }

.mdf .step-navigation .step-navigation__step .step-navigation__step-indicator { background: var(--white); border-width: 3px; border-radius: 35px; width: 35px; height: 35px; line-height: 30px; }

.mdf .step-navigation .step-navigation__step .step-navigation__step-indicator .step-icon { line-height: 28px; }

.mdf .step-navigation .step-navigation__step.active.backwards:not(.complete) .step-navigation__step-indicator { transition: color 0.4s ease-in-out 0.4s, border-color 0.4s ease-in-out 0.4s; }

.mdf .step-navigation .step-navigation__step.active.forwards:not(.complete) .step-navigation__step-indicator { transition: color 0.4s ease-in-out, border-color 0.4s ease-in-out; }

.mdf .step-navigation .step-navigation__step .step-navigation__step-line { margin-left: 17px; top: 35px; }

.mdf .step-navigation .step-navigation__step .step-navigation__step-line.active { transform-origin: center top; border-left-width: 3px; transform: scaleY(0); }

.mdf .step-navigation .step-navigation__step.complete.forwards .step-navigation__step-line.active { transition: transform 0.8s ease-in-out; transform: scaleY(1); }

.mdf .step-navigation .step-navigation__step.active.backwards .step-navigation__step-line.active { transition: transform 0.8s ease-in-out 0.4s; transform: scaleY(0); }

.mdf-taxId { display: flex; }

.mdf-taxId.column { flex-direction: column; gap: 4px; }

.mdf-taxId.row { flex-direction: row; }

.mdf-taxId.row .MDFSelectBox__control { min-width: 164px; }

.mdf-taxId.row .mdf-taxId-cell { margin-right: 10px; }

.mdf-taxId.row .mdf-taxId-applied-cell { margin-left: 10px; margin-right: 10px; }

.mdf-taxId .render-taxId { flex-direction: row; gap: 20px; display: flex; }

.mdf-taxId-cell { flex: 1 1 auto; display: flex; }

.mdf-taxId-cell .mdf-validated-field { flex: 1 1 auto; }

.mdf-taxId-cell .mdf-validated-field label { white-space: nowrap; }

.mdf-taxId-cell.nationalidentifier { display: block; }

.mdf-taxId-applied-cell { white-space: nowrap; align-self: flex-end; padding-bottom: 2px; }

.mdf-taxId-applied-cell .vdl-checkbox > label { white-space: nowrap; }

.mdf-taxId-notSpecified-cell { padding-top: 10px; }

@media (max-width: 767px) {
  .mdf-taxId .render-taxId { flex-direction: column; align-items: stretch; gap: 8px; }
  .mdf-taxId-applied-cell { align-self: normal; }
}

.mdf .vdl-textbox, .vdl-textbox { padding: 6px 10px; }

.mdf .mdf-label { font-size: 0.875rem; }

.mdf .mdf-label > label { margin: 0px; font-size: 0.875rem; font-weight: 500; }

.more-label .vdl-button--link.vdl-button--variant-text { color: var(--accent-0-darker); padding: 2px; font-weight: 700; }

@keyframes mdf-time-frame-slide-in-top { 
  0% { transform: translateY(-100%); }
}

@keyframes mdf-time-frame-slide-out-bottom { 
  100% { transform: translateY(110%); }
}

@keyframes mdf-time-frame-slide-out-right { 
  100% { transform: translate(500%); }
}

.mdf-time-frame-slide-in-top { animation: 1s ease-in 0s 1 normal forwards running mdf-time-frame-slide-in-top; }

.mdf-time-frame-slide-out-bottom { animation: auto ease-out 0s 1 normal forwards running mdf-time-frame-slide-out-bottom; }

.mdf-time-frame-slide-out-right { animation: 1s ease 0s 1 normal forwards running mdf-time-frame-slide-out-right; }

.mdf-time-frame__frame-wrapper--frame-animating { overflow: hidden; }

.mdf-time-frame__main-content-container { background: var(--white); border-top: 0px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; margin-bottom: 10px; margin-left: 40px; margin-right: 10px; padding: 0px 10px 15px 40px; box-shadow: rgba(0, 0, 0, 0.15) 0px 10px 15px; }

.mdf-time-frame__frame-timeline-container { align-items: center; height: 60px; display: flex; position: relative; left: 17px; }

.mdf-time-frame__timeline-wrapper { height: inherit; flex-grow: 1; align-items: center; display: flex; overflow: hidden; }

.mdf-time-frame__timeline-wrapper--timeline-open { flex-direction: row-reverse; justify-content: flex-end; }

.mdf-time-frame__dates-container { z-index: 0; transition: 1s; transform: translate(-100%); }

.mdf-time-frame__dates-container--slide-in-left { transform: translate(0px); }

.mdf-time-frame__open-timeline-link { height: 40px; color: var(--accent-0-dark); align-self: flex-start; align-items: center; margin-left: 5px; font-size: 13px; font-weight: 600; display: flex; }

.mdf-time-frame__open-timeline-link .fa-chevron-right { margin-left: 2px; }

.mdf-time-frame__open-timeline-link:hover { cursor: pointer; text-decoration: underline; }

.mdf-time-frame__timeline-line { border: 1px dashed var(--accent-0-dark); z-index: -1; justify-content: flex-end; height: 0px; margin-right: 35px; display: flex; position: relative; top: 14px; }

.mdf-time-frame__dates { display: flex; }

