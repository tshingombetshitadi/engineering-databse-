@charset "utf-8";

@font-face { font-family: "Futura Medium"; font-style: normal; font-weight: normal; src: local("Futura Medium"), local("Futura-Medium"), url("../fonts/futura-regular.woff") format("woff"); font-display: swap; }

@font-face { font-family: "Futura Bold"; font-style: normal; font-weight: bold; src: local("Futura Bold"), local("Futura-Bold"), url("../fonts/futura-bold.woff2") format("woff2"); font-display: swap; }

body, input, select, textarea { font-family: sans-serif; }

.btn, button, header, .tag, .filters a, h1.contrast, th { font-family: "Futura Medium"; }

h1, h2, h3, .imp, h1.contrast b, .membership-count b { font-family: "Futura Bold"; }

.container { max-width: 768px; padding: 0px 1em; margin: auto; }

@media screen and (max-width: 768px) {
  .container.full { padding: 0px; }
  .container.full .container-content { padding-left: 1em; padding-right: 1em; }
}

body { padding: 0px; margin: 0px; background: rgb(250, 250, 250); color: rgb(51, 51, 51); font-size: 15px; }

a { color: rgb(32, 172, 230); text-decoration: underline; }

main, .with-menu .main { display: grid; gap: 2px; }

@media screen and (max-width: 768px) {
  main > h1, main > h2, main > h3, .with-menu .main > h1, .with-menu .main > h2, .with-menu .main > h3 { padding-left: 1em; padding-right: 1em; }
}

.jumbo, .card { background: rgb(255, 255, 255); padding: 1em 2em; overflow: auto hidden; }

@media screen and (max-width: 600px) {
  .jumbo, .card { padding: 1em; }
}

.jumbo.error, .card.error { background: rgb(170, 0, 0); color: rgb(255, 255, 255); font-size: 1.1em; }

.jumbo.danger, .card.danger { background: rgb(255, 204, 204); border: 2px solid rgb(170, 0, 0); }

@media screen and (max-width: 768px) {
  .jumbo.danger, .card.danger { border-width: 2px 0px; }
}

.jumbo.with-illustration, .card.with-illustration { display: grid; grid-template-columns: 1fr 2fr; gap: 2em; }

.jumbo.with-illustration > .illustration, .card.with-illustration > .illustration { object-fit: cover; height: 100%; border-radius: 0.7em; }

.jumbo.warning, .card.warning { background: rgb(170, 170, 0); color: rgb(255, 255, 255); font-size: 1.1em; }

.jumbo.badge, .card.badge { font-weight: bold; }

.jumbo.badge a, .card.badge a { display: block; }

.jumbo.separate, .card.separate { margin-top: 2em; margin-bottom: 2em; }

.jumbo.submenu, .card.submenu { background-color: rgb(216, 244, 255); display: flex; }

.jumbo.submenu > :first-child, .card.submenu > :first-child { font-weight: bold; flex-grow: 1; }

.jumbo.empty, .card.empty { display: flex; align-items: center; justify-content: center; flex-direction: column; color: rgb(136, 136, 136); }

.jumbo.empty > *, .card.empty > * { margin: 1em 0px; width: 66%; }

@media screen and (max-width: 768px) {
  .jumbo.empty > *, .card.empty > * { width: auto; }
}

.card .card { border: 2px solid rgb(32, 172, 230); }

.card.wide-cover { padding: 0px; }

.divider { text-align: center; color: rgb(136, 136, 136); font-weight: bold; text-transform: uppercase; background: transparent; padding: 1em; }

.divider.small { padding: 0px; }

.jumbo, .card.membership { background: url("../img/watermark.svg") right center / 50% no-repeat rgb(216, 244, 255); }

.jumbo .actions, .card.membership .actions { text-align: right; }

.jumbo.split, .card.membership.split { display: grid; grid-template-columns: 2fr 1fr; gap: 2em; align-items: end; }

.card.membership { background-color: rgb(230, 97, 32); color: rgb(255, 255, 255); background-image: url("../img/watermark_membership.svg"); background-position: left bottom; background-size: cover; }

a.card.membership { text-decoration: none; }

a.card.membership:hover { text-decoration: underline; opacity: 0.8; }

p, ul, ol { margin: 1em 0px; line-height: 1.7em; }

img { max-width: 100%; }

.hero, .inline-hero { font-size: 1.2em; color: rgb(136, 136, 136); }

h1, .title, .hero { margin: 1em 0px; }

@media screen and (max-width: 600px) {
  h1, .title, .hero { text-align: center; }
}

h1 small, .title small, .hero small { font-size: 0.8em; color: rgba(51, 51, 51, 0.5); }

h1.contrast, .title.contrast, .hero.contrast { color: rgba(51, 51, 51, 0.5); }

h1.contrast b, .title.contrast b, .hero.contrast b { color: rgb(51, 51, 51); text-transform: uppercase; font-size: 0.9em; }

h1 { font-size: 1.5em; line-height: 1.8em; }

.title { margin: 1.5em 0px; }

.title h1 { margin: 0px; }

.text-danger { color: rgb(170, 0, 0); }

img { border: 0px; }

h2 { font-size: 1.2em; }

h2 a { color: inherit; }

code, pre { max-width: 100%; overflow-x: auto; white-space: normal; }

p a, ul a { word-break: break-word; }

.content-list > * { padding: 0.7em 0px; border-bottom: 1px solid rgb(216, 244, 255); }

.content-list > :last-child { border-bottom: 0px; }

.with-menu { grid-template-columns: 1fr 3fr; }

.two-parts { grid-template-columns: repeat(2, 1fr); }

.with-menu, .two-parts { display: grid; gap: 1em; }

@media screen and (max-width: 768px) {
  .with-menu, .two-parts { grid-template-columns: 1fr; }
}

.with-menu > .main, .two-parts > .main { }

.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }

.grid > * { background: rgb(255, 255, 255); }

@media screen and (max-width: 600px) {
  .grid { grid-template-columns: repeat(2, 1fr); }
}

@media screen and (max-width: 450px) {
  .grid { grid-template-columns: 1fr; }
}

blockquote { margin: 1em 0px; padding: 0.7em 1em; border-left: 2px solid rgb(32, 172, 230); }

.link-list { display: grid; gap: 0.7em; grid-template-columns: repeat(2, 1fr); }

.link-list.lg { grid-template-columns: 1fr; }

@media screen and (max-width: 768px) {
  .link-list { grid-template-columns: 1fr; }
}

.sr-only { display: none; }

.CodeMirror, .CodeMirror-scroll { min-height: 200px; max-height: 50vh; }

.progress { margin-top: 1em; height: 0.7em; background: rgb(255, 255, 255); border-radius: 0.7em; }

.progress > * { border-radius: 0.7em; height: 100%; background: rgb(32, 172, 230); }

.body-popup.narrow { max-width: 450px; margin: auto; }

.body-popup.narrow h1 { text-align: center; }

.announcement { position: fixed; bottom: 3px; left: 50%; transform: translateX(-50%); background: rgb(170, 170, 0); color: rgb(255, 255, 255); padding: 0.49em 1em; margin: auto 0px; border-radius: 0.7em; text-align: center; }

@media screen and (max-width: 600px) {
  .announcement { width: 100%; left: 0px; transform: none; }
}

header { background: linear-gradient(to right, rgb(24, 157, 213), rgb(87, 192, 236)); margin-bottom: 1em; position: sticky; top: 0px; z-index: 1000; }

@media screen and (max-width: 600px) {
  header { top: -3em; }
}

header.header-popup { padding: 1em 0px; }

header.header-popup img { height: 2rem; display: block; margin: auto; }

header .container { display: grid; grid-template-columns: max-content auto max-content; gap: 1em; grid-template-areas: "logo nav cta"; align-items: center; padding-top: 1em; padding-bottom: 1em; }

@media screen and (max-width: 768px) {
  header .container { grid-template-areas: "logo cta" "nav nav"; grid-template-columns: repeat(2, auto); grid-template-rows: 2em auto; gap: 1em; padding-top: 0.7em; padding-bottom: 0.7em; }
}

header #logo, header #branding { grid-area: logo; display: inline-block; }

header #logo { display: flex; height: 100%; align-items: center; }

header #logo img { height: 2em; }

@media screen and (max-width: 600px) {
  header #logo img { height: 1.7em; }
}

header #branding b { white-space: nowrap; color: rgb(255, 255, 255); font-size: 1.6em; }

@media screen and (max-width: 600px) {
  header #branding b { font-size: 1.4em; }
}

header #branding small { color: rgb(87, 192, 236); font-size: 1em; }

@media screen and (max-width: 600px) {
  header #branding small { color: rgb(255, 255, 255); display: none; }
}

header nav { grid-area: nav; text-align: right; justify-content: flex-end; flex-wrap: nowrap; display: flex; max-width: 100%; overflow: auto; gap: 1em; }

@media screen and (max-width: 450px) {
  header nav { gap: 0.49em; }
}

