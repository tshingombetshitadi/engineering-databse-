@charset "utf-8";

.hidden { display: none !important; }

.inline { display: inline; }

.inline + span { font-size: var(--font-size-label-small); }

.desktop-only { display: none !important; }

@media only screen and (min-width: 960px) {
  .desktop-only { display: block !important; }
  .mobile-only { display: none !important; }
}

#offline-info { background-color: var(--grey); color: var(--white); display: none; padding: var(--spacing-inset-sm) var(--spacing-inset-xs); text-align: center; }

.hidden--nojs { display: none; }

.client-js .hidden--nojs { display: block; }

.clearfix { clear: both; padding: var(--spacing-inset-xs); width: 100%; }

.shift { left: -10000px !important; position: absolute !important; }

a.hoverlink { text-decoration: underline dotted; }

.local-date-time { color: var(--dark-green); font-size: var(--font-size-label-small); padding: var(--spacing-inset-xs) 0 0; text-align: center; }

body, code, dd, div, dl, dt, fieldset, form, input, legend, li, ol, pre, td, textarea, th, ul { margin: 0px; padding: 0px; }

h1 { margin: var(--spacing-stack-lg) 0; }

body, li, p { color: var(--dark-grey); }

body { background-color: var(--beige); font-family: var(--font-family-body); font-size: 100%; line-height: normal; }

fieldset { width: 100%; }

p { line-height: var(--line-height-body); }

hr { background: rgba(232, 225, 196, 0.66); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; height: 1px; }

li { color: var(--dark-grey); list-style: none; }

a:link { color: var(--link-blue); text-decoration: underline; }

a:hover, a:visited { color: var(--dark-blue); text-decoration: underline; }

h1, h2, h3, h4, h5, h6 { color: var(--grey); font-family: var(--font-family-body); font-weight: 600; }

div.head { margin-bottom: var(--spacing-stack-sm); margin-top: var(--spacing-stack-lg); }

div.head span { font-size: var(--font-size-label-medium); }

code, pre { font-family: var(--font-family-code); font-size: 0.875em; font-weight: 400; white-space: pre-wrap; }

@media only screen and (max-width: 768px) {
  table:not(.no-table-collapse), table:not(.no-table-collapse) tbody, table:not(.no-table-collapse) tr { display: block; overflow: auto; }
  table:not(.no-table-collapse) td { display: inline-block; }
}

a.nostyle { color: inherit; }

h1 { font-size: var(--font-size-headline-large); }

h1.title { font-size: var(--font-size-title-large); }

h1 span.subtitle { font-size: var(--font-size-title-small); font-weight: 400; }

h1.publisher { color: var(--brown); font-size: var(--font-size-headline-medium); margin: 0px; font-family: var(--font-family-serif) !important; font-weight: 400 !important; }

h1 span.count { font-size: var(--font-size-label-large) !important; }

h2 { font-size: var(--font-size-headline-small); }

h2.author { font-size: var(--font-size-title-medium); }

h2.author, h2.authorEdition { color: var(--brown); font-weight: 400; }

h2.authorEdition { font-size: var(--font-size-title-small); margin: 0px; padding: 0px; }

h2.publisher { background-color: var(--lightest-grey); }

h2.edition-title { color: var(--grey); font-family: var(--font-family-title); font-size: var(--font-size-title-medium); font-weight: 400; margin: var(--spacing-stack-sm) 0 0; }

h2 a { color: var(--link-blue); text-decoration: none; }

h2 a:hover { color: var(--dark-green); text-decoration: underline; }

h1.edition, h2.edition { color: var(--black); font-family: var(--font-family-body); font-size: var(--font-size-title-medium); font-weight: 400; margin: 0px; padding: 0px; }

h3, h3.Question { font-size: var(--font-size-title-large); }

h3.Question { border-top: 1px dotted var(--lighter-grey); color: var(--brown); font-family: var(--font-family-serif); font-weight: 400; margin-top: var(--spacing-stack-sm); padding-top: var(--spacing-inset-sm); }

h4 { font-size: var(--font-size-title-medium); }

h4.observer-count, h4.publisher { font-family: var(--font-family-body); font-weight: 400; }

h4.facetHead { align-items: center; color: var(--black); display: inline-flex; font-family: var(--font-family-body); font-size: var(--font-size-label-medium); font-weight: 700; gap: var(--spacing-inline-sm); margin: 0px; padding: 0px; text-transform: uppercase; }

h4.facetHead .facet-icon { color: var(--mid-grey); flex-shrink: 0; }

h4.facetHead span.merge { background: url("/static/images/icons/icon_merge-sm.png") 0px 0px no-repeat; font-family: var(--font-family-body); font-size: var(--font-size-label-small); min-height: 16px; padding-left: 22px; font-weight: 400 !important; text-transform: none !important; }

h5 { font-size: var(--font-size-title-small); font-family: var(--font-family-serif) !important; font-weight: 400 !important; }

h6 { font-size: var(--font-size-label-medium); }

.head h2 a { text-decoration: none; color: inherit !important; }

.head h2 a:hover { text-decoration: underline; }

div.head h1, div.head h2, div.head h3, div.head h4, div.head h5, div.head h6 { margin: 0px; padding: 0px; }

div.head.rel { position: relative; }

dt, h6.title, span.title { color: var(--grey); font-size: var(--font-size-label-medium); margin: 0px; padding: 0px; font-weight: 400 !important; }

