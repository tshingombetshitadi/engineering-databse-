.panel > p { padding: 1em; }

.panel input, .panel textarea { border-radius: 0px; padding: 16px 1em; }

.mw-body > .content .panel { background-color: var(--background-color-interactive,#eaecf0); clear: both; margin-top: 1em; text-align: center; }

.mf-spinner-icon-element { padding: 12px; }

.mf-spinner-icon-element span + span { display: block; clip: rect(1px, 1px, 1px, 1px); width: 1px; height: 1px; margin: -1px; border: 0px; padding: 0px; overflow: hidden; position: absolute !important; }

.promised-view { position: absolute; inset: 0px; display: flex; justify-content: center; align-items: center; }

.mw-mf-anchor { color: var(--color-progressive,#36c); border-radius: 2px; text-decoration: none; }

.mw-mf-anchor:visited { color: var(--color-visited,#6a60b0); }

.mw-mf-anchor:visited:hover { color: var(--color-visited--hover,#534fa3); }

.mw-mf-anchor:visited:active { color: var(--color-visited--active,#353262); }

.mw-mf-anchor:hover { color: var(--color-progressive--hover,#3056a9); text-decoration: underline; }

.mw-mf-anchor:active { color: var(--color-progressive--active,#233566); text-decoration: underline; }

.mw-mf-anchor:focus-visible { outline: solid 2px var(--outline-color-progressive--focus,#36c); }

@supports not selector(:focus-visible) {
  .mw-mf-anchor:focus { outline: solid 2px var(--outline-color-progressive--focus,#36c); }
}

.mw-mf-anchor .cdx-icon:not(.cdx-thumbnail__placeholder__icon--vue):last-child { min-width: 10px; min-height: 10px; width: var(--font-size-medium,1rem); height: var(--font-size-medium,1rem); padding-left: 4px; vertical-align: middle; }

.mw-mf-anchor-progressive { text-decoration: underline; }

.mw-mf-anchor-destructive { color: var(--color-destructive,#bf3c2c); }

.mw-mf-anchor-destructive:visited { color: var(--color-destructive--visited,#9f5555); }

.mw-mf-anchor-destructive:visited:hover { color: var(--color-destructive--visited--hover,#854848); }

.mw-mf-anchor-destructive:visited:active { color: var(--color-destructive--visited--active,#512e2e); }

.mw-mf-anchor-destructive:hover { color: var(--color-destructive--hover,#9f3526); text-decoration: underline; }

.mw-mf-anchor-destructive:active { color: var(--color-destructive--active,#612419); text-decoration: underline; }

.mw-mf-anchor-destructive:focus { outline-color: var(--outline-color-progressive--focus,#36c); }

.drawer { text-align: center; padding-top: 0px; padding-bottom: 1em; max-width: 500px; margin: 0px auto; }

.drawer.text { font-size: 0.9em; text-align: left; padding-top: 0.5em; }

.drawer p { margin-top: 0.5em; }

.drawer p, .drawer a:not(:last-child) { margin-bottom: 1em; }

.has-drawer--with-scroll-locked { overflow: hidden; }

.overlay-enabled .drawer { display: none !important; }

.drawer-container__mask { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.8); transition: opacity 100ms ease-in-out; opacity: 0; }

.drawer-container__mask--visible { opacity: 0.2; }

.overlay.overlay-loading { display: flex; align-items: center; justify-content: center; background-color: var(--background-color-backdrop-light,rgba(255,255,255,0.65)); }

.overlay.overlay-loading .header { display: none; }

.overlay.overlay-loading .overlay-content { overflow: hidden; }

.overlay-enabled { }

.overlay-enabled #mw-mf-page-center { overflow: hidden; display: block; }

.overlay-enabled #mw-mf-page-center, .overlay-enabled .overlay { height: 100%; }

.hidden { display: none !important; }

.overlay { position: absolute; top: 0px; left: 0px; width: 100%; background: var(--background-color-base,#fff); z-index: 1; display: none; }

.overlay .cdx-button { border-radius: 0px; }

.overlay.visible { display: block; }

.overlay input, .overlay textarea { font-size: 16px; }

.overlay .summary.oo-ui-textInputWidget { max-width: none; }

.overlay .summary.oo-ui-textInputWidget textarea { width: 100%; }

.overlay .captcha-word { margin: 0px 0px 0.7em; width: 100%; }

.overlay .wikitext-editor { min-height: 50%; line-height: 1.5; border: 0px; }

.overlay .panel { padding-top: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color-muted,#dadde3); }

.overlay-footer-container { background-color: var(--background-color-base,#fff); bottom: 0px; border-top: 1px solid var(--border-color-subtle,#c8ccd1); }

.overlay-footer-container a { display: block; padding: 1em 1em 1em 10px; line-height: 1em; text-align: center; }

.overlay-header .overlay-title { width: 100%; }

.overlay-header .header-action a[disabled], .overlay-header .header-action button[disabled] { opacity: 0.5; }

.overlay-header .header-action .oo-ui-widget { margin-right: 1em; }

.overlay-header .submit { background-color: var(--background-color-progressive,#36c); color: var(--color-inverted,#fff); }

.overlay-header h2 { display: table; width: 100%; font-size: 1em; }

.overlay-header h2 > * { width: 1em; display: table-cell; padding-right: 0.4em; }

.overlay-header h2 span { width: auto; max-width: 1em; }

.overlay-header > ul li { display: block; }

.overlay-footer-container, .overlay-header-container { width: 100%; background: var(--background-color-base,#fff); z-index: 2; }

.overlay-footer-container.position-fixed, .overlay-header-container.position-fixed { position: fixed; left: 0px; right: 0px; }

.overlay-header-container { top: 0px; }

.overlay-bottom { border-top: 1px solid var(--border-color-subtle,#c8ccd1); top: auto; bottom: 0px; background: var(--background-color-interactive-subtle,#f8f9fa); height: auto !important; }

