@charset "utf-8";

#reveal-ad { position: absolute; inset: 0px; background: rgba(255, 255, 255, 0.01); display: none; }

#simple-expand-bar { position: absolute; bottom: 0px; left: 0px; right: 0px; height: 28px; background-color: rgb(255, 255, 255); opacity: 0.95; border: 1px solid rgb(233, 233, 233); border-radius: 0px; box-shadow: none; text-align: center; }

#reveal-ad-button > div { padding-top: 3px; }

#reveal-ad-button #ads-badge { background-color: rgb(87, 149, 106); color: rgb(255, 255, 255); font: 500 11px / 13px Roboto; border-radius: 2px; padding: 0px 2px; margin-left: 20px; margin-right: 6px; }

