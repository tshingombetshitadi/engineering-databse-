@charset "utf-8";

.ns-iupkc-l-square { opacity: 1; position: relative; }

@keyframes slide-down { 
  0% { transform: translateY(-100%); filter: opacity(0%); }
  100% { transform: translateY(0%); filter: opacity(100%); }
}

@keyframes bounce { 
  0% { transform: translateY(-100%); filter: opacity(0%); }
  100% { transform: translateY(0%); filter: opacity(100%); }
}

@keyframes slide-in { 
  0% { transform: translateX(-100%); filter: opacity(0%); }
  100% { transform: translateX(0%); filter: opacity(100%); }
}

@keyframes slide-in-right { 
  0% { transform: translateX(100%); filter: opacity(0%); }
  100% { transform: translateX(0%); filter: opacity(100%); }
}

@keyframes fadein { 
  0% { filter: opacity(0%) blur(10px); }
  100% { filter: opacity(100%) blur(0px); }
}

@keyframes flash { 
  0% { transform: scale(2); filter: opacity(0%); }
  100% { transform: scale(1); filter: opacity(100%); }
}

.ns-iupkc-l-square .rda-logo, .title, .title-large-font, .body, .url, .image, .white-button { opacity: 1; }

.ns-iupkc-l-square .button-container { background-color: rgb(9, 42, 36); color: rgb(255, 255, 255); }

.ns-iupkc-l-square .title.free { text-overflow: initial; }

.ns-iupkc-l-square .title-large-font.free { text-overflow: initial; }

.ns-iupkc-e-1, .ns-iupkc-e-2 { background-color: rgb(234, 251, 248); }

.ns-iupkc-e-4, .ns-iupkc-e-6 { color: rgb(17, 85, 72); }

.ns-iupkc-e-7, .ns-iupkc-e-17 { white-space: nowrap; }

