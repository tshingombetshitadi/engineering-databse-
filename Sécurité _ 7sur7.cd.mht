#expander-glasspane { width: 384px; height: 384px; left: 0px; position: absolute; top: 0px; z-index: 9019; }

#expander-glasspane > img { width: 100%; height: 100%; }

#reveal-ad { display: block; }

#reveal-ad-button { margin: 0px auto; width: calc(382px); max-width: calc(382px); }
