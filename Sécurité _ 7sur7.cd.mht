@charset "utf-8";

@keyframes skeleton-enter { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes skeleton-stretch-in { 
  0% { transform: scaleX(0); }
  100% { transform: scaleX(1); }
}

@keyframes inline-shimmer { 
  0% { background-position: 0% 0%; }
  100% { background-position: -200% 0%; }
}

#skeleton-loader { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; padding: 16px; box-sizing: border-box; width: 100%; }

.loader { inline-size: var(--line-width, 100%); block-size: 16px; border-radius: 8px; animation-direction: ; animation-play-state: ; animation-timeline: ; animation-range-start: ; animation-range-end: ; background: linear-gradient(90deg, rgb(240, 244, 249) 20%, rgb(240, 244, 249), rgb(211, 219, 229), rgb(240, 244, 249)) 0% 0% / 200% 100%; transform-origin: left center; animation-name: skeleton-enter, skeleton-stretch-in, inline-shimmer; animation-duration: 350ms, 600ms, 2100ms; animation-delay: 200ms, 250ms, 50ms; animation-fill-mode: both; animation-timing-function: linear, cubic-bezier(0.2, 0, 0, 1), linear; animation-iteration-count: 1, 1, infinite; }
