@charset "utf-8";

body { font-family: "Google Sans", Roboto, Arial, sans-serif; margin: 0px; padding-block-start: 8px; overflow: hidden; }

.display-slot-container { line-height: 0; }

#original-content { padding-block-end: 24px; overflow: hidden; background-image: linear-gradient(rgb(233, 241, 254) 0px, transparent 300px); min-height: 300px; }

.header { line-height: 35px; font-size: 25px; font-weight: 400; padding-inline: 24px; padding-block-start: 24px; }

#gda-search-term { color: rgb(66, 133, 244); }

@supports (background-clip: text) {
  #gda-search-term { background-image: linear-gradient(90deg, rgb(66, 133, 244), rgb(51, 161, 206)); background-clip: text; color: transparent; }
}

.generated-by { font-size: 14px; font-weight: 500; color: rgb(31, 31, 31); padding: 16px 24px 0px; display: flex; align-items: center; gap: 8px; height: 24px; }

.icon { flex-shrink: 0; }

[dir="rtl"] .icon { transform: scaleX(-1); }

.generated-by span { margin-bottom: -2px; }

#original-content .display-slot-container { float: left; padding-block-start: 16px; }

p, ul, h1, h2, h3 { margin: 0px 24px; font-size: 16px; font-weight: 400; line-height: 25px; color: rgb(92, 95, 94); clear: both; }

h1, h2, h3 { font-size: 20px; font-weight: 500; color: rgb(31, 31, 31); padding-block-start: 24px; }

p, ul { padding-block-start: 16px; }

.item-title { font-weight: 500; color: rgb(31, 31, 31); }

.disclaimer-container { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; padding: 16px 24px 0px; }

.disclaimer { font-size: 12px; line-height: 16px; color: rgb(92, 95, 94); padding: 0px; flex-grow: 1; }

.feedback-btns { display: flex; gap: 2px; flex-shrink: 0; }

.feedback-btn { position: relative; background: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 50%; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; color: rgb(92, 95, 94); cursor: pointer; transition: background-color 0.1s, border-color 0.1s, color 0.1s, opacity 0.1s; padding: 0px; }

.feedback-btn:hover { background-color: rgb(241, 243, 244); color: rgb(31, 31, 31); }

.feedback-btn .icon-sel, .feedback-btn.selected .icon-def { display: none; }

.feedback-btn.selected .icon-sel { display: block; }

#feedback-neg svg { transform: rotate(180deg); }
