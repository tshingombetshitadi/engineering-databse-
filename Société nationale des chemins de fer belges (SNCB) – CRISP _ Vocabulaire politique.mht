.pum-theme-55 .pum-title, .pum-theme-framed-border .pum-title { color: rgb(0, 0, 0); text-align: left; text-shadow: rgba(2, 2, 2, 0.23) 0px 0px 0px; font-family: inherit; font-weight: 100; font-size: 32px; line-height: 36px; }

.pum-theme-55 .pum-content, .pum-theme-framed-border .pum-content { color: rgb(45, 45, 45); font-family: inherit; font-weight: 100; }

.pum-theme-55 .pum-content + .pum-close, .pum-theme-framed-border .pum-content + .pum-close { position: absolute; height: 20px; width: 20px; inset: -20px -20px auto auto; padding: 0px; color: rgb(255, 255, 255); font-family: Tahoma; font-weight: 700; font-size: 16px; line-height: 18px; border: 1px rgb(255, 255, 255); border-radius: 0px; box-shadow: rgba(2, 2, 2, 0.23) 0px 0px 0px 0px; text-shadow: rgba(0, 0, 0, 0.23) 0px 0px 0px; background-color: rgba(0, 0, 0, 0.55); }

.pum-theme-56, .pum-theme-floating-bar { background-color: rgba(255, 255, 255, 0); }

.pum-theme-56 .pum-container, .pum-theme-floating-bar .pum-container { padding: 8px; border-radius: 0px; border: 1px rgb(0, 0, 0); box-shadow: rgba(2, 2, 2, 0.23) 1px 1px 3px 0px; background-color: rgb(238, 246, 252); }

.pum-theme-56 .pum-title, .pum-theme-floating-bar .pum-title { color: rgb(80, 80, 80); text-align: left; text-shadow: rgba(2, 2, 2, 0.23) 0px 0px 0px; font-family: inherit; font-weight: 400; font-size: 32px; line-height: 36px; }

.pum-theme-56 .pum-content, .pum-theme-floating-bar .pum-content { color: rgb(80, 80, 80); font-family: inherit; font-weight: 400; }

.pum-theme-56 .pum-content + .pum-close, .pum-theme-floating-bar .pum-content + .pum-close { position: absolute; height: 18px; width: 18px; inset: 50% 5px auto auto; padding: 0px; color: rgb(80, 80, 80); font-family: sans-serif; font-weight: 700; font-size: 15px; line-height: 18px; border: 1px solid rgb(80, 80, 80); border-radius: 15px; box-shadow: rgba(2, 2, 2, 0) 0px 0px 0px 0px; text-shadow: rgba(0, 0, 0, 0) 0px 0px 0px; background-color: rgba(255, 255, 255, 0); transform: translate(0px, -50%); }

.pum-theme-57, .pum-theme-content-only { background-color: rgba(0, 0, 0, 0.7); }

.pum-theme-57 .pum-container, .pum-theme-content-only .pum-container { padding: 0px; border-radius: 0px; border: 1px rgb(0, 0, 0); box-shadow: rgba(2, 2, 2, 0) 0px 0px 0px 0px; }

.pum-theme-57 .pum-title, .pum-theme-content-only .pum-title { color: rgb(0, 0, 0); text-align: left; text-shadow: rgba(2, 2, 2, 0.23) 0px 0px 0px; font-family: inherit; font-weight: 400; font-size: 32px; line-height: 36px; }

.pum-theme-57 .pum-content, .pum-theme-content-only .pum-content { color: rgb(140, 140, 140); font-family: inherit; font-weight: 400; }

.pum-theme-57 .pum-content + .pum-close, .pum-theme-content-only .pum-content + .pum-close { position: absolute; height: 18px; width: 18px; inset: 7px 7px auto auto; padding: 0px; color: rgb(0, 0, 0); font-family: inherit; font-weight: 700; font-size: 20px; line-height: 20px; border: 1px rgb(255, 255, 255); border-radius: 15px; box-shadow: rgba(2, 2, 2, 0) 0px 0px 0px 0px; text-shadow: rgba(0, 0, 0, 0) 0px 0px 0px; background-color: rgba(255, 255, 255, 0); }

#pum-61 { z-index: 1999999999; }

#pum-66 { z-index: 1999999999; }

#pum-64 { z-index: 1999999999; }

#pum-58 { z-index: 1999999999; }
