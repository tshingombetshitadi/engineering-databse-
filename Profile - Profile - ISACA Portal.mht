.pfm-button_dot { margin-bottom: -3px; }

.pfm-button_dot { animation: 1.25s ease 0.5s infinite normal none running pfm-animation_bounce; }

.pfm-button_dot:nth-of-type(1) { animation-delay: 0.35s; }

.pfm-button_dot:nth-of-type(2) { animation-delay: 0.5s; }

.pfm-button_dot:nth-of-type(3) { animation-delay: 0.65s; }

@keyframes pfm-animation_bounce { 
  0% { transform: scale(1, 1) translateY(0px); }
  10% { transform: scale(1.1, 0.9) translateY(0px); }
  30% { transform: scale(0.9, 1.1) translateY(-6px); }
  50% { transform: scale(1.05, 0.95) translateY(2px); }
  100% { transform: scale(1, 1) translateY(0px); }
}
